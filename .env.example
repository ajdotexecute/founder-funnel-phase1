POSTGRES_USER=founder
POSTGRES_PASSWORD=founder_pass
POSTGRES_DB=founder_funnel

# local | box (box isn't implemented until Checkpoint 5)
STORAGE_BACKEND=local

# Unset -> neutral demo config/theme (clients/demo/). Set to "fg" once the
# real 4T criteria are supplied (clients/fg/).
CLIENT_ID=demo

# Required for Checkpoint 3's live extraction/scoring calls. Leave blank to
# keep it out of this environment — the app runs, but any submission's
# extraction/scoring will fail gracefully (processing_error in the response)
# without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Optional — format validation works without it; the actual lookup (status,
# incorporation date, SIC codes) is skipped gracefully if unset.
COMPANIES_HOUSE_API_KEY=
